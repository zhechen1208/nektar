<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <EXPANSIONS>
        <E COMPOSITE="C[5]" NUMMODES="5" FIELDS="u,v,p" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="AdvectionForm" VALUE="Convective" />
            <I PROPERTY="Projection" VALUE="Galerkin" />

        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.001      </P>
            <P> NumSteps = 100        </P>
            <P> IO_InfoSteps = 200     </P>
            <P> IO_FlowSteps = 100     </P>
            <P> Re = 10                 </P>
            <P> Flowrate = 2/3         </P>
            <P> Kinvis = 1/Re          </P>
            <!-- Wave Parameters -->
            <P> AL = 10               </P>
            <P> alpha = 2              </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>       <!-- top wall -->
            <B ID="1"> C[2] </B>       <!-- bottom wall -->
            <B ID="2"> C[3] </B>       <!-- inlet -->
            <B ID="3"> C[4] </B>       <!-- outlet -->
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <!-- Region 0: top wall -->
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>

            <!-- Region 1: bottom wall -->
            <REGION REF="1">
                <D VAR="u" VALUE="0.5*AL/Re*cos(alpha*x)" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>

            <!-- Region 2: inlet -->
            <REGION REF="2">
                <P VAR="u" VALUE="[3]" />
                <P VAR="v" VALUE="[3]" />
                <P VAR="p" VALUE="[3]" />
            </REGION>

            <!-- Region 3: outlet -->
            <REGION REF="3">
                <P VAR="u" USERDEFINEDTYPE="Flowrate" VALUE="[2]" />
                <P VAR="v" VALUE="[2]" />
                <P VAR="p" VALUE="[2]" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="FlowrateForce" >
            <E VAR="ForceX" VALUE="1" />
            <E VAR="ForceY" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="1-y^2" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="1-y^2" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>

    </CONDITIONS>

    <FILTERS>

        <FILTER TYPE="HistoryPoints">
            <PARAM NAME="OutputFile">History</PARAM>
            <PARAM NAME="OutputFrequency">200</PARAM>
            <PARAM NAME="Points">
                2.5 0.0 0.0
            </PARAM>
        </FILTER>
    </FILTERS>

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></VERTEX>
        <EDGE COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></EDGE>
        <ELEMENT>
            <Q COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></Q>
        </ELEMENT>
        <COMPOSITE>
            <C ID="1"> E[3,6,9,12,15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87] </C>
            <C ID="2"> E[1092,1094,1096,1098,1100,1102,1104,1106,1108,1110,1112,1114,1116,1118,1120,1122,1124,1126,1128,1130,1132,1134,1136,1138,1140,1142,1144,1146,1148] </C>
            <C ID="3"> E[0,88,147,206,265,324,383,442,501,560,619,678,737,796,855,914,973,1032,1091] </C>
            <C ID="4"> E[86,146,205,264,323,382,441,500,559,618,677,736,795,854,913,972,1031,1090,1149] </C>
            <C ID="5"> Q[0-550] </C>
        </COMPOSITE>
        <DOMAIN>
            <D ID="0"> C[5] </D>
        </DOMAIN>
    </GEOMETRY>
</NEKTAR>


