<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[5]" NUMMODES="3" TYPE="GLL_LAGRANGE" FIELDS="u,v,theta,p" />
    </EXPANSIONS>

    <CONDITIONS>

        <SOLVERINFO>
            <I PROPERTY="SolverType"                    VALUE="VelocityCorrectionScheme"    />
            <I PROPERTY="EQTYPE"                        VALUE="UnsteadyNavierStokes"        />
            <I PROPERTY="EvolutionOperator"             VALUE="Nonlinear"                   />
            <I PROPERTY="Projection"                    VALUE="Galerkin"                    />
            <I PROPERTY="GlobalSysSoln"                 VALUE="DirectStaticCond"            />
            <I PROPERTY="Driver"                        VALUE="Standard"                    />
            <I PROPERTY="SPECTRALHPDEALIASING"          VALUE="True"                        />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <!-- Need to pick Delta t strategically, dont want CFL number to be too large! -->
            <P> TimeStep       = 1e-1           </P>

            <!--  Final time -->
            <P> T              = 100            </P>
            <P> NumSteps       = T/TimeStep     </P>
            <P> IO_InfoSteps   = 1/TimeStep     </P>
            <P> IO_CFLSteps    = 1/TimeStep     </P>

            <!-- Reynolds number -->
            <P> Re             = 1              </P>
            <P> Kinvis         = 1/Re           </P>
            <P> Flowrate       = 2/3            </P>

            <!-- Heating parameters  -->
            <P> Ra            = 2000/8          </P>
            <P> Pr            = 1               </P>
        </PARAMETERS>


        <VARIABLES>
            <V ID="0">u</V>
            <V ID="1">v</V>
            <V ID="2">theta</V>
            <V ID="3">p</V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1]   </B>   <!-- Inlet  -->
            <B ID="1"> C[2]   </B>   <!-- Outlet -->
            <B ID="2"> C[3]   </B>   <!-- Top    -->
            <B ID="3"> C[4]   </B>   <!-- Bot    -->
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <P VAR="u"      VALUE="[1]" />
                <P VAR="v"      VALUE="[1]" />
                <P VAR="theta"  VALUE="[1]" />
                <P VAR="p"      VALUE="[1]" />
            </REGION>
            <REGION REF="1">
                <P VAR="u"      USERDEFINEDTYPE="Flowrate" VALUE="[0]" />
                <P VAR="v"      VALUE="[0]" />
                <P VAR="theta"  VALUE="[0]" />
                <P VAR="p"      VALUE="[0]" />
            </REGION>
            <REGION REF="2">
                <D VAR="u"      VALUE="0" />
                <D VAR="v"      VALUE="0" />
                <D VAR="theta"  VALUE="0" />
                <N VAR="p"      USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="3">
                <D VAR="u"      VALUE="0" />
                <D VAR="v"      VALUE="0" />
                <D VAR="theta"  VALUE="1" />
                <N VAR="p"      USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="DiffusionCoefficient" >
            <E VAR="theta" VALUE="1/Re/Pr" />
        </FUNCTION>

        <FUNCTION NAME="FlowrateForce" >
            <E VAR="ForceX" VALUE="1" />
            <E VAR="ForceY" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="BodyForce">
            <E VAR="u"          VALUE="0"                   EVARS="u v theta" />
            <E VAR="v"          VALUE="Ra/Pr/Re/Re*theta"   EVARS="u v theta" />
            <E VAR="theta"      VALUE="0"                   EVARS="u v theta"/>
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <F FILE="ScaleReynoldsShearFilter_ThermalChannel2D.rst"/>
        </FUNCTION>

    </CONDITIONS>
    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE>BodyForce</BODYFORCE>
        </FORCE>
    </FORCING>

    <FILTERS>
        <FILTER TYPE="ReynoldsStresses">
            <PARAM NAME="SampleFrequency">5</PARAM>
            <PARAM NAME="OutputFrequency">100/TimeStep</PARAM>
            <PARAM NAME="ScaleNumModes">1.4</PARAM>
        </FILTER>
    </FILTERS>
    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></VERTEX>
        <EDGE COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></EDGE>
        <ELEMENT>
            <Q COMPRESSED="B64Z-LittleEndian" BITSIZE="64"></Q>
        </ELEMENT>
        <COMPOSITE>
            <C ID="1"> E[3,33,54,75,96,117,138,159,180,201] </C>
            <C ID="2"> E[29,50,71,92,113,134,155,176,197,218] </C>
            <C ID="3"> E[200,203,205,207,209,211,213,215,217,219] </C>
            <C ID="4"> E[28,25,22,19,16,13,10,7,4,0] </C>
            <C ID="5"> Q[0-99] </C>
        </COMPOSITE>
        <DOMAIN>
            <D ID="0"> C[5] </D>
        </DOMAIN>
    </GEOMETRY>
