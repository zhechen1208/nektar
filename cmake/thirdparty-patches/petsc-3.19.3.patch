+import re
+def parse_makefile(filename):
+    """A simple replacement for the removed sysconfig._parse_makefile"""
+    with open(filename, 'r') as f:
+        lines = f.readlines()
+    vars = {}
+    for line in lines:
+        match = re.match(r'^(\w+)\s*=\s*(.*)$', line)
+        if match:
+            vars[match.group(1)] = match.group(2)
+    return vars
